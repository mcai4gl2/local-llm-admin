#!/usr/bin/python3
"""Resident ownership guard. JSON is metadata only; never execute paths or shell fragments."""

from __future__ import annotations

import hashlib
import json
import math
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any


class GuardError(ValueError):
    pass


def digest(body: dict[str, Any]) -> str:
    value = {key: val for key, val in body.items() if key != "catalog_hash"}
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def _path(value: Any) -> Path:
    if not isinstance(value, str) or not Path(value).is_absolute() or ".." in Path(value).parts:
        raise GuardError("Invalid resident manifest path.")
    return Path(value)


def _graph(components: dict[str, Any]) -> None:
    visited: set[str] = set()
    active: set[str] = set()
    def visit(name: str) -> None:
        if name not in components or name in active:
            raise GuardError("Invalid resident dependency graph.")
        if name in visited:
            return
        active.add(name)
        for dependency in components[name]["requires"]:
            visit(dependency)
        active.remove(name)
        visited.add(name)
    for name in components:
        visit(name)


def load_manifest(path: Path) -> dict[str, Any]:
    if not path.exists():
        if (path.parent.parent / "ocr").exists():
            raise GuardError("Missing resident manifest for installed OCR runtime.")
        # Legacy detection only, until a normalized catalog is provisioned.
        root = path.parent.parent
        return {"schema_version": 0, "root": str(root), "engines": [], "headroom_gb": 6,
                "owners": [{"id": "qwen-embed", "category": "service", "enabled": True,
                            "root": str(root / "embed"), "allowed_mlx": ["*"],
                            "reservation_gb": 9, "components": [{
                                "id": "api", "port": 8084,
                                "pid_file": str(root / "embed/run/qwen-embed.pid"),
                                "marker": "mlx_vlm.server", "requires": [],
                            }]}]}
    try:
        if path.is_symlink() or path.stat().st_mode & 0o022:
            raise GuardError("Unsafe resident manifest permissions.")
        body = json.loads(path.read_text())
        if not isinstance(body, dict) or body.get("schema_version") != 1 or body.get("catalog_hash") != digest(body):
            raise GuardError("Resident manifest hash or version differs.")
        root = _path(body["root"])
        if root != path.parent.parent:
            raise GuardError("Resident manifest root differs.")
        headroom = body["headroom_gb"]
        if type(headroom) not in (int, float) or not math.isfinite(headroom) or headroom < 0:
            raise GuardError("Invalid resident memory headroom.")
        ids: set[str] = set()
        ports: set[int] = set()
        for owner in body["owners"]:
            name = owner["id"]
            if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9-]*", name) or name in ids:
                raise GuardError("Duplicate or invalid resident manifest identity.")
            ids.add(name)
            owner_root = _path(owner["root"])
            if not owner_root.is_relative_to(root) or owner_root == root or type(owner["enabled"]) is not bool:
                raise GuardError("Invalid resident manifest ownership.")
            if (owner["category"] not in ("service", "sidecar") or not isinstance(owner["allowed_mlx"], list)
                    or any(not isinstance(name, str) or not name for name in owner["allowed_mlx"])):
                raise GuardError("Invalid resident manifest policy.")
            components = {c["id"]: c for c in owner["components"]}
            if len(components) != len(owner["components"]) or "api" not in components:
                raise GuardError("Duplicate or missing resident component.")
            _graph(components)
            for component in owner["components"]:
                if not _path(component["pid_file"]).is_relative_to(owner_root / "run"):
                    raise GuardError("Invalid resident process record.")
                if not isinstance(component["marker"], str) or not component["marker"]:
                    raise GuardError("Missing resident command identity.")
                port = component["port"]
                if port is not None:
                    if type(port) is not int or not 0 <= port <= 65535 or port and port in ports:
                        raise GuardError("Conflicting resident manifest ports.")
                    if port:
                        ports.add(port)
        for engine in body["engines"]:
            if engine["id"] in ids:
                raise GuardError("Conflicting engine and resident identities.")
            ids.add(engine["id"])
            _path(engine["root"])
            _path(engine["pid_file"])
            if any(port in ports for port in engine["ports"]):
                raise GuardError("Conflicting engine and resident manifest ports.")
        return body
    except (OSError, ValueError, KeyError, TypeError) as exc:
        if isinstance(exc, GuardError):
            raise
        raise GuardError("Invalid or unreadable resident manifest.") from None


def processes() -> list[tuple[int, str]]:
    try:
        result = subprocess.run(["ps", "-axo", "pid=,command="], capture_output=True,
                                text=True, timeout=3, check=True)
        return [(int(pid), command) for line in result.stdout.splitlines()
                for pid, _, command in [line.strip().partition(" ")] if command]
    except (OSError, ValueError, subprocess.SubprocessError):
        raise GuardError("Cannot verify process ownership.") from None


def port_open(port: int) -> bool:
    if not port:
        return False
    try:
        result = subprocess.run(
            ["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN"],
            capture_output=True, timeout=3, check=False,
        )
        if result.returncode not in (0, 1):
            raise GuardError("Cannot verify listener ownership.")
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        raise GuardError("Cannot verify listener ownership.") from None


def _running(owner: dict[str, Any], inventory: list[tuple[int, str]]) -> tuple[bool, bool]:
    root = owner["root"] + "/"
    records = owner["components"]
    matching = {pid for pid, command in inventory if root in command and any(
        component["marker"] in command for component in records
    )}
    expected = set()
    unverified = False
    for component in records:
        try:
            pid_file = Path(component["pid_file"])
            pid = int(pid_file.read_text().strip())
            expected.add(pid)
            if owner.get("generation_checked") and pid in matching:
                record = json.loads(pid_file.with_suffix(".json").read_text())
                started = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)],
                                         capture_output=True, text=True, timeout=3, check=True).stdout
                command = next(command for observed, command in inventory if observed == pid)
                if (record["pid"] != pid or record["pgid"] != os.getpgid(pid)
                        or " ".join(record["started"].split()) != " ".join(started.split())
                        or record["command"] != command):
                    unverified = True
        except FileNotFoundError:
            unverified = unverified or owner.get("generation_checked", False) and bool(matching)
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            raise GuardError(f"{owner['id']} ownership record is unreadable.") from None
    listening = any(port_open(component["port"]) for component in records if component["port"])
    # An orphan matching the fixed runtime is still an owner, but cannot be called ready.
    unknown = unverified or bool(matching - expected) or listening and not matching
    return bool(matching) or listening, bool(unknown)


def _sysctl(name: str) -> int | None:
    try:
        value = subprocess.run(["sysctl", "-n", name], capture_output=True,
                               text=True, timeout=3, check=True).stdout.strip()
        return int(value)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def listener_pids(port: int) -> set[int]:
    if not port:
        return set()
    try:
        result = subprocess.run(["lsof", "-nP", f"-tiTCP:{port}", "-sTCP:LISTEN"],
                                capture_output=True, text=True, timeout=3, check=False)
        if result.returncode not in (0, 1):
            raise GuardError("Cannot verify engine listener ownership.")
        return {int(pid) for pid in result.stdout.split()}
    except (OSError, ValueError, subprocess.SubprocessError):
        raise GuardError("Cannot verify engine listener ownership.") from None


def _engine_inventory(manifest: dict[str, Any], inventory: list[tuple[int, str]]) -> list[dict[str, Any]]:
    observed = []
    known_pids: set[int] = set()
    listeners: set[int] = set()
    for engine in manifest["engines"]:
        matching = {pid for pid, command in inventory
                    if engine["root"] + "/" in command and engine["marker"] in command}
        known_pids.update(matching)
        for port in engine["ports"]:
            listeners.update(listener_pids(port))
        if matching:
            observed.append(engine)
    if listeners - known_pids:
        raise GuardError("An unknown engine listener owns resources.")
    return observed


def _mlx_state(manifest: dict[str, Any], reference: str | None = None) -> tuple[str | None, float | None]:
    root = Path(manifest["root"])
    try:
        if reference is None:
            values = dict(line.split("=", 1) for line in (root / "run/active.env").read_text().splitlines()
                          if "=" in line)
            name = values.get("MLX_ACTIVE_NAME")
            path = _path(values.get("MLX_ACTIVE_PATH"))
        else:
            name = reference
            registry = [line.split("\t", 1) for line in (root / "etc/models.conf").read_text().splitlines()
                        if line and not line.lstrip().startswith("#")]
            matches = [entry[1] for entry in registry if len(entry) == 2 and entry[0] == reference]
            if len(matches) != 1:
                return name, None
            path = _path(matches[0])
        if not path.is_relative_to(root / "models"):
            return name, None
        cfg = json.loads((path / "config.json").read_text())
        text = cfg.get("text_config", cfg)
        profile_path = root / "etc/profiles" / f"{name}.json"
        profile = json.loads(profile_path.read_text()) if profile_path.exists() else {}
        tokens = profile.get("launch", {}).get("max_kv_size") or text.get("max_position_embeddings")
        layers, heads = text.get("num_hidden_layers"), text.get("num_key_value_heads") or text.get("num_attention_heads")
        dim = text.get("head_dim")
        if dim is None and text.get("hidden_size") and text.get("num_attention_heads"):
            dim = text["hidden_size"] // text["num_attention_heads"]
        types = text.get("layer_types")
        if isinstance(types, list) and types:
            layers = sum(t == "full_attention" for t in types)
        elif text.get("full_attention_interval"):
            layers //= text["full_attention_interval"]
        if not all(type(value) is int and value > 0 for value in (tokens, layers, heads, dim)):
            return name, None
        weights = sum(file.stat().st_size for file in path.rglob("*") if file.is_file())
        return name, (weights + tokens * layers * heads * dim * 4) / 1024**3
    except (OSError, ValueError, TypeError, AttributeError):
        return None, None


def _budget(manifest: dict[str, Any], owners: list[dict[str, Any]], mlx_gb: float | None) -> None:
    reservations = [o["reservation_gb"] for o in owners]
    if (type(mlx_gb) not in (float, int) or not math.isfinite(mlx_gb) or mlx_gb < 0
            or any(type(value) not in (float, int) or not math.isfinite(value) or value <= 0
                   for value in reservations)):
        raise GuardError("Model or resident memory reservation is unknown.")
    ram = _sysctl("hw.memsize")
    wired = _sysctl("iogpu.wired_limit_mb")
    if _sysctl("kern.memorystatus_vm_pressure_level") != 1 or not ram or ram <= 0:
        raise GuardError("Memory pressure or capacity is unknown or not normal.")
    limit = ram / 1024**3 - manifest["headroom_gb"]
    if wired is None or wired < 0:
        raise GuardError("Wired memory limit is unknown.")
    if wired:
        limit = min(limit, wired / 1024)
    if (mlx_gb or 0.0) + sum(reservations) > limit:
        raise GuardError("Aggregate model and resident memory exceeds the limit.")


def guard(manifest: dict[str, Any], policy: str, reference: str | None = None) -> None:
    inventory = processes()
    observed = [(owner, *_running(owner, inventory)) for owner in manifest["owners"]]
    active = [owner for owner, running, _ in observed if running]
    if policy == "exclusive":
        if active:
            raise GuardError("Resident resources remain: " + ", ".join(o["id"] for o in active))
        return
    if policy == "mlx":
        for owner, running, unknown in observed:
            if unknown or running and not owner["enabled"]:
                raise GuardError(f"{owner['id']} ownership is unknown or disabled.")
            if running and reference not in owner["allowed_mlx"] and "*" not in owner["allowed_mlx"]:
                raise GuardError(f"{reference} is not allowed next to {owner['id']}.")
        if manifest["schema_version"] == 1:
            _, target_gb = _mlx_state(manifest, reference)
            _budget(manifest, active, target_gb)
        return
    if policy not in ("resident", "slot"):
        raise GuardError("Unknown resident guard policy.")
    if manifest["schema_version"] == 0 and policy == "slot":
        return  # retain original slot wrappers until normalized catalog provisioning
    candidate = next((o for o in manifest["owners"] if o["id"] == reference), None)
    if (candidate is None or not candidate["enabled"]
            or candidate["category"] != ("service" if policy == "resident" else "sidecar")):
        raise GuardError("Resident service is not registered and enabled.")
    if manifest["schema_version"] == 0:
        return  # existing wrappers retain their legacy exclusive-engine checks
    if any(unknown for _, _, unknown in observed):
        raise GuardError("Resident process ownership is unknown.")
    if policy == "slot" and any(o["category"] == "sidecar" and o["id"] != reference for o in active):
        raise GuardError("Another sidecar owns the exclusive slot.")
    engines = _engine_inventory(manifest, inventory)
    if any(engine["exclusive"] for engine in engines) or len(engines) > 1:
        raise GuardError("An exclusive or ambiguous engine owns resources.")
    name, mlx_gb = _mlx_state(manifest) if engines else (None, 0.0)
    owners = {o["id"]: o for o in [*active, candidate]}
    if engines and (mlx_gb is None or any(name not in o["allowed_mlx"] and "*" not in o["allowed_mlx"]
                                         for o in owners.values())):
        raise GuardError("MLX ownership, memory or compatibility is unknown.")
    _budget(manifest, list(owners.values()), mlx_gb)


def main() -> int:
    try:
        if len(sys.argv) < 3:
            raise GuardError("Usage: resident-services MANIFEST validate|guard POLICY [REFERENCE]")
        body = load_manifest(Path(sys.argv[1]))
        if sys.argv[2] == "validate" and len(sys.argv) == 3:
            print(json.dumps({"catalog_hash": body.get("catalog_hash"), "schema_version": body["schema_version"]}))
        elif sys.argv[2] == "guard" and 4 <= len(sys.argv) <= 5:
            guard(body, sys.argv[3], sys.argv[4] if len(sys.argv) == 5 else None)
        else:
            raise GuardError("Invalid resident guard command.")
        return 0
    except GuardError as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
