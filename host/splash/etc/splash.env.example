# Copy privately, replace the key and chmod 600. Parsed, never sourced.
# Generate a private key: openssl rand -hex 24
#SPLASH_API_KEY=replace-with-a-private-key-of-at-least-32-characters
SPLASH_HOST=127.0.0.1
# Explicit LAN bind: SPLASH_HOST=0.0.0.0
SPLASH_ALLOWED_HOSTS=mac-mini.local

# Use a separate port for persistent Splash gateway routes; match the admin settings.
# Omitted keeps the legacy shared endpoint.
#SPLASH_PORT=8085
