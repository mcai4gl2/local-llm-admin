# /Volumes/Models/strata/etc/strata.env (mode 600). Parsed by bin/strata, never sourced.
# Optional. Without a key Strata is open on the LAN at :8080, like the MLX server, so
# LiteLLM's route needs nothing. With one, every client must send it.
# Generate a key: openssl rand -hex 24
#STRATA_API_KEY=replace-with-32-to-256-chars-of-A-Za-z0-9_-
# Optional: extra Host names to answer without a key (IPs and the Mac's own name always pass)
#STRATA_ALLOWED_HOSTS=llm.example.com
# The default pack set up by Strata's ./setup.sh (strata-<pack>.json must exist): Q2_0 or
# IQ3_XXS. Used until a pack is picked (admin Engine control or `bin/strata start <pack>`);
# the last pick is then kept in run/strata.pack.
STRATA_MODEL=Q2_0
# For display only, when a run config does not say: setup fixes the context per pack
STRATA_CONTEXT=262144
