{
  "id": "splash-quality-pilot-v1",
  "version": 1,
  "title": "Splash deterministic quality pilot",
  "description": "Core eval cases plus coding-output questions. Fixed-suite binary accuracy only; no code execution or general quality claim.",
  "cases": [
    {
      "id": "if-ready",
      "category": "instruction",
      "prompt": "Reply with exactly the word READY in capital letters and nothing else.",
      "max_tokens": 16,
      "grader": {
        "type": "regex",
        "pattern": "^\\s*READY\\s*$"
      }
    },
    {
      "id": "if-colors",
      "category": "instruction",
      "prompt": "List the three primary colors of light as a comma-separated list in lowercase, with no other text.",
      "max_tokens": 32,
      "grader": {
        "type": "regex",
        "pattern": "^(?=.*\\bred\\b)(?=.*\\bgreen\\b)(?=.*\\bblue\\b)\\s*[a-z]+\\s*,\\s*[a-z]+\\s*,\\s*[a-z]+\\s*$"
      }
    },
    {
      "id": "if-five-words",
      "category": "instruction",
      "prompt": "Write one sentence about the sea that is exactly five words long and ends with a period. Output only the sentence.",
      "max_tokens": 32,
      "grader": {
        "type": "regex",
        "pattern": "^\\s*[^\\s.]+(\\s+[^\\s.]+){4}\\.\\s*$"
      }
    },
    {
      "id": "if-json-capital",
      "category": "instruction",
      "prompt": "Reply with a JSON object only, with the keys \"city\" and \"country\", naming the capital city of Japan.",
      "max_tokens": 64,
      "grader": {
        "type": "json_fields",
        "fields": {
          "city": "Tokyo",
          "country": "Japan"
        }
      }
    },
    {
      "id": "if-backwards",
      "category": "instruction",
      "prompt": "Write the word banana backwards, in lowercase, and nothing else.",
      "max_tokens": 16,
      "grader": {
        "type": "exact",
        "answer": "ananab"
      }
    },
    {
      "id": "ex-invoice",
      "category": "extraction",
      "prompt": "Extract the fields invoice_number, vendor, date, total and currency from this text as a JSON object, with total as a number:\n\nInvoice 4471 from Northwind Traders, dated 2026-03-14, total 1,250.00 EUR.",
      "max_tokens": 128,
      "grader": {
        "type": "json_fields",
        "fields": {
          "invoice_number": 4471,
          "vendor": "Northwind Traders",
          "date": "2026-03-14",
          "total": 1250,
          "currency": "EUR"
        }
      }
    },
    {
      "id": "ex-meeting",
      "category": "extraction",
      "prompt": "Return a JSON object with the keys day, time, room and host for this message:\n\nMeeting moved: the design review is now on Thursday at 15:30 in Room B4, hosted by Priya.",
      "max_tokens": 96,
      "grader": {
        "type": "json_fields",
        "fields": {
          "day": "Thursday",
          "time": "15:30",
          "room": "B4",
          "host": "Priya"
        }
      }
    },
    {
      "id": "ex-contact",
      "category": "extraction",
      "prompt": "Return a JSON object with the keys last_name, email and phone for this text:\n\nYou can reach Dr. Alan Ortiz at a.ortiz@example.org or +1-555-0142 (office).",
      "max_tokens": 96,
      "grader": {
        "type": "json_fields",
        "fields": {
          "last_name": "Ortiz",
          "email": "a.ortiz@example.org",
          "phone": "+1-555-0142"
        }
      }
    },
    {
      "id": "ex-order",
      "category": "extraction",
      "prompt": "Return a JSON object with item_count (the total number of units) and total (the total price as a number) for this order:\n\n2 x USB-C cable at 9.50 each and 1 x charger at 24.00.",
      "max_tokens": 96,
      "grader": {
        "type": "json_fields",
        "fields": {
          "item_count": 3,
          "total": 43
        }
      }
    },
    {
      "id": "ex-flight",
      "category": "extraction",
      "prompt": "Return a JSON object shaped like {\"flight\": str, \"from\": {\"city\": str, \"code\": str}, \"to\": {\"city\": str, \"code\": str}} for this text:\n\nFlight QX218 departs Lisbon (LIS) at 07:05 and arrives in Oslo (OSL) at 11:40.",
