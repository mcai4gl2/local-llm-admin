# ~/.config/local-llm-admin/env on the Mac (chmod 600). Generate the hash with:
#   ~/local-llm-admin/.venv/bin/local-llm-admin-hash
ADMIN_PASSWORD_HASH='$argon2id$...'
ADMIN_SESSION_SECRET=<python3 -c "import secrets; print(secrets.token_hex(32))">
ADMIN_DATA_DIR=/Users/<you>/local-llm-admin/data
ADMIN_LOG_DIR=/Users/<you>/local-llm-admin/logs
MLX_ROOT=/Volumes/Models
MLX_API_BASE=http://127.0.0.1:8080
# browser-facing ComfyUI link on the dashboard (default http://127.0.0.1:8188)
COMFYUI_PUBLIC_URL=http://mac-mini.local:8188
LITELLM_BASE_URL=http://litellm.example.com:4000
# a LiteLLM key with the proxy_admin_viewer role and models ["no-default-models"] (DESIGN.md §5.6)
LITELLM_ADMIN_KEY=sk-...
# comma-separated; an entry ending in "/" is a prefix (default: every local weights dir and
# Strata's Q2_0 and IQ3_XXS model ids)
LITELLM_LOCAL_MODELS=openai//Volumes/Models/models/,openai/qwen3.8-flash-next-q2_0,openai/qwen3.8-flash-next-iq3_xxs
LITELLM_TIMEZONE_OFFSET_MIN=-480
# M1 resilience (defaults shown). WATCHDOG_ENABLED=false keeps alerts but never restarts MLX.
#WATCHDOG_ENABLED=true
#WATCHDOG_GRACE_S=30
#WATCHDOG_CRASH_WINDOW_S=1800
# M2 quality runs (defaults shown): per-request and whole-run limits, model ready wait
#QUALITY_REQUEST_TIMEOUT_S=300
#QUALITY_RUN_DEADLINE_S=14400
#QUALITY_READY_TIMEOUT_S=60
#QUALITY_RETENTION_DAYS=90
#MONITOR_INTERVAL_S=15
#PROBE_TIMEOUT_S=3
#ALERT_RETENTION_DAYS=90
# M4 observability (defaults shown): availability sample interval, request/availability
# retention, slow-request threshold, daily log rotation (size, archives kept, local hour)
#AVAILABILITY_INTERVAL_S=60
#OBSERVABILITY_RETENTION_DAYS=90
#PERF_SLOW_TTFT_S=10
#LOG_ROTATE_MAX_MIB=50
#LOG_ROTATE_KEEP=8
#LOG_ROTATE_HOUR=4
# M3 model lifecycle (defaults shown): inventory scan bound; Hugging Face owners whose
# repositories may be downloaded (comma-separated, "*" allows any); CLI call bound
#INVENTORY_TIMEOUT_S=20
#DOWNLOAD_ALLOWED_OWNERS=mlx-community
#DOWNLOAD_CLI_TIMEOUT_S=60
# M6 decision sidecar (OpenJev on DiffusionGemma), off by default. DECISION_API_KEY is
# OPENJEV_API_KEY from /Volumes/Models/decision/etc/openjev.env. Footprint is the measured
# peak (Phase 0); allowed MLX models may run next to it (comma-separated registered names;
# default: none, so set each *_ALLOWED_MLX for the models you run)
#DECISION_ENABLED=false
#DECISION_API_KEY=
#DECISION_FOOTPRINT_GB=20
#DECISION_HEADROOM_GB=6
#DECISION_ALLOWED_MLX=my-chat-model
#DECISION_READY_TIMEOUT_S=120
# M6 LAN gateway (only with DECISION_ENABLED=true): per-client keys, OpenJev-compatible
#DECISION_GATEWAY_HOST=0.0.0.0
#DECISION_GATEWAY_PORT=8082
# keys are optional on the LAN; true refuses requests without a valid dsk_ key (401)
#DECISION_GATEWAY_REQUIRE_KEY=false
#DECISION_GATEWAY_MAX_INFLIGHT=4
#DECISION_GATEWAY_CLIENT_INFLIGHT=2
# M7 TTS sidecar (Qwen3-TTS), off by default. Defaults are the Phase 0 measurements
# (mlx-audio 0.5.7, 2026-10-04); chunk size and timeout count CJK characters as 4.
#TTS_ENABLED=false
#TTS_PORT=8083
#TTS_API_BASE=http://127.0.0.1:8083
#TTS_FOOTPRINT_GB=8
#TTS_ALLOWED_MLX=my-chat-model,my-chat-model-8bit
#TTS_MAX_INPUT_CHARS=10000
#TTS_CHUNK_CHARS=800
#TTS_TIMEOUT_BASE_S=30
#TTS_TIMEOUT_PER_CHAR_S=0.04
#TTS_VOICES=Vivian,Serena,Uncle_Fu,Dylan,Eric,Ryan,Aiden,Ono_Anna,Sohee
#TTS_DEFAULT_VOICE=Vivian
#TTS_MODEL_ID=qwen3-tts
#TTS_UPSTREAM_MODEL=/Volumes/Models/tts/models/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit
#TTS_READY_PATH=/v1/models
#TTS_FFMPEG=/opt/homebrew/bin/ffmpeg

# Embedding service (M8): always on next to the chat model; stops for ComfyUI
#EMBED_ENABLED=false
#EMBED_PORT=8084
#EMBED_API_BASE=http://127.0.0.1:8084
#EMBED_FOOTPRINT_GB=9
#EMBED_ALLOWED_MLX=my-chat-model,my-chat-model-8bit
#EMBED_UPSTREAM_MODEL=/Volumes/Models/embed/models/Qwen3-Embedding-4B-8bit
#RERANK_UPSTREAM_MODEL=/Volumes/Models/embed/models/Qwen3-Reranker-0.6B
#EMBED_MAX_IN_FLIGHT=2
#EMBED_MAX_INPUTS=32
#EMBED_MIN_INTERVAL_MS=1500
#EMBED_TIMEOUT_PER_INPUT_S=0.2

# Independent resident OCR; disabled and unqualified by default. Choose free loopback
# ports privately, then render the matching resident-services.json from these settings.
# See docs/ocr.md and host/ocr/README.md; no native packages enter the admin/embedding venv.
#OCR_ENABLED=false
#OCR_ROOT=/Volumes/Models/ocr
#OCR_PORT=0
#OCR_VLM_PORT=0
#OCR_FOOTPRINT_GB=0
# Zero means unknown and refuses admission; set a provisional qualification reservation,
# then validate it against measured full-pipeline/rendering peak before production use.
#OCR_ALLOWED_MLX=my-chat-model
#OCR_READY_TIMEOUT_S=240
#OCR_MODEL_ID=local-ocr
#OCR_MODEL_REVISION=c5630abae1d940eafe0697512a0325494b02ab42
#OCR_PRECISION=bf16

# Strata engine (Qwen3.8-Flash-Next on Metal), off by default. A third engine next to MLX
# and ComfyUI: switching to it stops every sidecar and service. It serves on MLX's :8080, so
# LiteLLM's route reaches whichever engine runs. STRATA_API_KEY: the one in
# /Volumes/Models/strata/etc/strata.env, if that file sets one. Strata serves qwen3.8-flash-next-<pack, lower case>;
# the Q2_0 and IQ3_XXS ids are in the LITELLM_LOCAL_MODELS default; add any other pack's id.
#STRATA_ENABLED=false
#STRATA_API_BASE=http://127.0.0.1:8080
#STRATA_PORT=8080
#STRATA_API_KEY=
#STRATA_READY_TIMEOUT_S=300

# M10 task-quality evals (defaults shown). EVAL_JUDGE: none | external | mlx:<registered name>.
# external needs an OpenAI-compatible endpoint, a model id and (if required) a key.
#EVAL_RUN_DEADLINE_S=43200
#EVAL_THINKING_MAX_TOKENS=8192
#EVAL_JUDGE=none
#EVAL_JUDGE_BASE_URL=http://litellm.example.com:4000
#EVAL_JUDGE_MODEL=judge-model
#EVAL_JUDGE_API_KEY=
#EVAL_IMPORT_MAX_BYTES=2000000
#EVAL_IMPORT_MAX_CASES=2000


# Splash standalone engine, opt-in after private preparation and approved rollout.
# See host/splash/README.md. Its key must match the private host env.
# Native absolute-path aliases are unsupported. The shared /v1 entry point accepts the
# legacy MLX model ID and translates it to the selected engine; see docs/shared-inference.md.
#SPLASH_ENABLED=false
#SPLASH_ROOT=/Volumes/Models/splash
#SPLASH_API_BASE=http://127.0.0.1:8080
#SPLASH_PORT=8080
# Match the native host splash.env port and API_BASE; LiteLLM uses shared admin /v1.
#SPLASH_API_KEY=
#SPLASH_POLL_INTERVAL_S=15
SPLASH_READY_TIMEOUT_S=300
#SPLASH_STOP_TIMEOUT_S=45

# One OpenAI-compatible URL for every selected LLM engine: admin /v1 (normally :8090/v1).
# Configure LiteLLM once with openai/local-model and this private bearer key.
# An empty key disables the entry point. Native backend addresses/keys remain internal.
# See docs/shared-inference.md for migration and legacy model-ID compatibility.
#INFERENCE_API_KEY=
#INFERENCE_MODEL_ID=local-model

# Shared OpenAI listener on the existing :8080/v1, with unchanged upstream model IDs.
# Empty key disables it. Reuse the key already supplied by the LiteLLM route.
# Install private etc/engine-ports.json and align all native addresses before enabling.
# See docs/shared-inference.md for the paired migration and rollback.
#INFERENCE_API_KEY=
#INFERENCE_PORT=8080
#INFERENCE_HOST=0.0.0.0
#INFERENCE_MODEL_ID=local-model
# Native settings when the shared listener is enabled:
#MLX_PORT=8086
#MLX_API_BASE=http://127.0.0.1:8086
#STRATA_PORT=8087
#STRATA_API_BASE=http://127.0.0.1:8087
#SPLASH_PORT=8085
#SPLASH_API_BASE=http://127.0.0.1:8085
