{
  "name": "local-llm-admin",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "workspaceFolder": "/workspaces/local-llm-admin",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/local-llm-admin,type=bind",
  "remoteUser": "vscode",
  "postCreateCommand": "sudo rm -f /etc/apt/sources.list.d/yarn.list && sudo apt-get update && sudo apt-get install -y --no-install-recommends rsync openssh-client zsh sqlite3 && pipx install uv && uv sync --frozen --all-extras",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
